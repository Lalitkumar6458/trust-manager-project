# ---------------- Database ----------------
# Mac (Homebrew):   postgres://trust:trust@localhost:5432/trust
# VPS:              written by deploy/setup-vps.sh
DATABASE_URL=postgres://trust:trust@localhost:5432/trust
# DATABASE_SSL=true          # only for a managed database that needs SSL
# DATABASE_POOL_MAX=10

# ---------------- Files (uploaded documents, logo, signature …) ----------------
# default: ./uploads inside the project. On the VPS: /var/lib/trust-manager/uploads
# UPLOAD_DIR=/var/lib/trust-manager/uploads

# ---------------- Scheduled jobs (monthly report, daily digest, next FY) ----------------
# any long random text; cron sends it in the x-cron-secret header
CRON_SECRET=change-me-to-a-long-random-text

# ---------------- Off-site backup (deploy/backup.sh – README 4.1) ----------------
# BACKUP_REMOTE=gdrive:trust-backups
# BACKUP_PASSPHRASE='long secret – keep a written copy, without it the backup cannot be opened'
# REMOTE_KEEP_DAYS=90

# ---------------- Receipt QR verification ----------------
# optional: fixed secret for signing receipt links (else one is created in the database automatically).
# Do NOT change it later – QR codes on already printed receipts would stop verifying.
# RECEIPT_SECRET=

# ---------------- Misc ----------------
# Dates (today, month, FY) use this time zone – keep India time
TZ=Asia/Kolkata
# Session cookie only over HTTPS (true on the VPS with SSL; false for http://localhost)
# COOKIE_SECURE=true

# ---------------- Multi-sanstha / SaaS mode (README 4.6) ----------------
# Leave these out for a single trust. When set, every sanstha gets its own database (tm_<shortname>)
# picked by the web address, and the owner control panel opens on CONTROL_HOST.
# CONTROL_DATABASE_URL=postgres://trust:<password>@localhost:5432/tm_control
# CONTROL_HOST=admin.yourbrand.in
# TENANT_BASE_DOMAIN=yourbrand.in
# TENANT_POOL_MAX=3
