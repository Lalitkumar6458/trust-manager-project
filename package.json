{
  "name": "trust-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Trust Donation & Accounting Management Web Panel (Next.js + Firebase)",
  "scripts": {
    "i18n:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-check.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "create-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-super-admin.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "cd functions && npm install && cd .. && firebase deploy --only functions",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:storage": "firebase deploy --only storage",
    "deploy:backend": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.3.8",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
