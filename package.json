{
  "name": "trust-manager",
  "version": "2.0.0",
  "private": true,
  "description": "Trust Donation & Accounting Management Web Panel (Next.js + PostgreSQL)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-migrate.mjs",
    "create-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-super-admin.mjs",
    "control:owner": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-owner.mjs",
    "migrate:firebase": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-from-firebase.mjs",
    "i18n:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-check.mjs",
    "seed:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-demo.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/alias.mjs --test tests/unit.test.mjs",
    "test:smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "next": "^16.3.8",
    "nodemailer": "^6.10.1",
    "papaparse": "^5.7.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "optionalDependencies": {
    "firebase-admin": "^14.5.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
